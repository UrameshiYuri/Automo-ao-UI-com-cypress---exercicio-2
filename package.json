{
  "name": "cy-lens",
  "version": "1.0.0",
  "description": "Cypress Lens",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress run",
    "report": "npm run mergeJsonReport && npm run generateReport",
    "mergeJsonReport": "npx mochawesome-merge ./mochawesome-report/*.json -o ./mochawesome-report/result.json",
    "generateReport": "npx marge ./mochawesome-report/result.json -o ./mochawesome-report",
    "start": "npx serverest",
    "cy:run-ci": "start-server-and-test start http://lojaebac.ebaconline.art.br/ test",
    "cy:base":"cypress run --env type=base",
    "cy:actual":"cypress run --env type=actual"
    
  },
  "author": "ernestosbarbosa",
  "license": "ISC",
  "dependencies": {
    "cypress": "^13.6.3",
    "cypress-html-reporter": "^11.0.0",
    "cypress-lens": "^1.12.0",
    "dotenv": "^16.4.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^4.3.0",
    "puppeteer": "^24.35.0",
    "start-server-and-test": "^3.0.11"
  },
  "devDependencies": {
    "serverest": "^2.25.4"
  }
}
